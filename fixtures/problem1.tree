; problem1.tree — the corpus specimen (chain rule), showing the building method.
; Trees 2–5 were authored blind; their judgment notes are in author-report.md.

element 1 — the whole equation
1 eq
  lhs: element 2
  rhs: element 7

element 2 — left side: d/dx as a fraction, then the fifth power
2 flat
  - element 3
  - element 4

element 3 — the d/dx fraction exactly as written
3 frac
  num: ident  d
  den: flat
    - ident  d
    - ident  x

element 4 — (3x^2 + 1/x) to the fifth
4 sup
  base: element 5
  exp: num  5

element 5 — the parenthesized sum inside the power
5 group
  - element 6

element 6 — the run 3x^2 + 1/x
6 flat
  - flat
    - num  3
    - sup
      base: ident  x
      exp: num  2
  - op  +
  - frac
    num: num  1
    den: ident  x

element 7 — right side: the product run 5 · (..)^4 · (6x - 1/x^2)
7 flat
  - num  5
  - element 8
  - op  *
  - element 9

element 8 — the fourth power of the same group
8 sup
  base: same: element 5
  exp: num  4

element 9 — the group (6x - 1/x^2)
9 group
  - flat
    - num  6
    - ident  x
    - op  -
    - frac
      num: num  1
      den: sup
        base: ident  x
        exp: num  2
